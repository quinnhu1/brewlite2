# Run bash deploy/init-env.sh to create real random secrets; never commit .env.production.
DOMAIN=your-domain.example
ACME_EMAIL=you@example.com
VPS_IPV4=52.64.177.7
IMAGE_REGISTRY=ghcr.io/your-github-owner/brewlite2
IMAGE_TAG=local
POSTGRES_PASSWORD=GENERATE_WITH_INIT_ENV
JWT_SECRET=GENERATE_WITH_INIT_ENV
PAYMENT_PROVIDER=vnpay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Enable only when your sandbox merchant is allowed to refund.
VNPAY_REFUND_ENABLED=false
PAYMENT_ALLOW_MOCK_IN_PRODUCTION=false
PAYMENT_MOCK_ALLOW_OVERRIDE=false
