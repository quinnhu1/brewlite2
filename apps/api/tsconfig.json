{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    // Global type packages. Without this list the editor type-checks the
    // *.spec.ts files without jest's globals and reports `describe`/`it`.
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false
  }
}
