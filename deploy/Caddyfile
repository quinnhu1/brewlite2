  email {$ACME_EMAIL}
}
{$DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    -Server
  }
  @docs path /api/swagger* /api/swagger-json /api/swagger-yaml
  respond @docs "API documentation is available locally or through SSH." 404
  handle_path /api/* {
    reverse_proxy api:3001
  }
  handle {
    reverse_proxy web:3000
  }
}
