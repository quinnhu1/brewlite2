# Copy to /opt/brewlite/.env on the VPS and fill in real values.
# deploy/release.sh sources this file; docker compose interpolates it as well.

# --- public site -----------------------------------------------------
# Bare hostname, no scheme. DNS A/AAAA record must point at the VPS and ports
# 80/443 must be reachable so Caddy can issue the TLS certificate.
PUBLIC_DOMAIN=brew.example.com

# --- images ----------------------------------------------------------
# owner/repo exactly as on GitHub; images are ghcr.io/<repo>-api and -web.
GITHUB_REPOSITORY=quinnhu1/brewlite2
# Only needed when the GHCR packages are private (PAT with read:packages).
GHCR_USER=
GHCR_TOKEN=

# --- database --------------------------------------------------------
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=brewlite
# Inside the compose network the database host is "db".
DATABASE_URL=postgresql://brewlite:change-me-strong-password@db:5432/brewlite?schema=public
DIRECT_URL=postgresql://brewlite:change-me-strong-password@db:5432/brewlite?schema=public
# deploy/backup.sh keeps this many days of dumps in /opt/brewlite/backups.
BACKUP_RETENTION_DAYS=7

# --- api -------------------------------------------------------------
# 64 random characters, e.g. openssl rand -hex 32
JWT_SECRET=replace-me
JWT_EXPIRES_IN_SECONDS=604800
# Public origin of the web app; used for CORS. Same host as PUBLIC_DOMAIN.
FRONTEND_URL=https://brew.example.com
# Caddy is exactly one reverse-proxy hop in front of the API.
TRUST_PROXY_HOPS=1

# --- payments --------------------------------------------------------
PAYMENT_PROVIDER=vnpay
# Leave both empty to disable VNPay (the API then reports not configured).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Public URL behind Caddy; the browser is sent here after paying.
VNPAY_RETURN_URL=https://brew.example.com/api/payments/vnpay/return
# Register https://brew.example.com/api/payments/vnpay/ipn as the IPN URL.
VNPAY_QUERY_IP=
