@startuml
!theme plain
skinparam defaultFontName DejaVu Sans
skinparam linetype ortho
hide empty methods
title Class-01 — domain và quan hệ chính
class User {
 userId: UUID
 role: customer/staff/admin
 point: int
}
class Product {
 productId: UUID
 basePrice: MoneyVND
 stock: int
 version: int
}
class Order {
 orderId: UUID
 total: MoneyVND
 status: OrderStatus
 stockReserved: boolean
 cancellationRequestedAt: datetime?
 replacementOfOrderId: UUID?
}
class OrderItem {
 quantity: int
 size: string
 unitPrice: MoneyVND
 lineTotal: MoneyVND
}
class Payment {
 paymentId: UUID
 idempotencyKey: string
 amount: MoneyVND
 status: PaymentStatus
 provider: string
 gatewayRef: string?
 nextCheckAt: datetime?
}
class Refund {
 refundId: UUID
 requestId: string
 amount: MoneyVND
 status: RefundStatus
 submittedAt: datetime?
 completedAt: datetime?
}
class Promotion {
 code: string
 type: percentage/fixed
 minAmount: MoneyVND
 maxDiscount: MoneyVND?
}
class LoyaltyTransaction {
 type: EARN/ADJUST/REDEEM/EXPIRE
 points: int
 orderId: UUID?
}
enum OrderStatus {
 pending
 payment_failed
 paid
 preparing
 ready
 completed
 cancelled
}
enum PaymentStatus {
 pending
 success
 failed
 refunded
}
enum RefundStatus {
 requested
 processing
 succeeded
 failed
 review_required
}
User "1" -- "0..*" Order
Order "1" *-- "1..*" OrderItem
Product "1" -- "0..*" OrderItem
Order "1" -- "0..*" Payment
Payment "1" -- "0..1" Refund
Promotion "0..1" -- "0..*" Order
User "1" -- "0..*" LoyaltyTransaction
Order "0..1" -- "0..*" LoyaltyTransaction
Order ..> OrderStatus
Payment ..> PaymentStatus
Refund ..> RefundStatus
note bottom of Order
Order có 0..1 đơn gốc, đơn gốc có 0..* đơn thay thế.
Enum DB còn giữ trạng thái legacy để tương thích.
Luồng mới chỉ dùng các trạng thái ở đây.
end note
@enduml
