@startuml
!theme plain
left to right direction
skinparam defaultFontName DejaVu Sans
title UC-01 — phạm vi use-case trọng tâm
actor Customer as C
actor "VNPay / Mock" as G
rectangle BrewLite {
  usecase "Đặt và thanh toán" as UC
  usecase "Kiểm tra JWT / DTO" as AUTH
  usecase "Tính giá và giữ tồn" as STOCK
  usecase "Ghi nhận thanh toán" as PAY
  usecase "Xem kết quả / tracking" as TRACK
}
C -- UC
UC ..> AUTH : <<include>>
UC ..> STOCK : <<include>>
UC ..> PAY : <<include>>
G -- PAY
C -- TRACK
note bottom of AUTH: Đăng nhập là tiền điều kiện, không bắt đăng nhập lại mỗi đơn.
@enduml
