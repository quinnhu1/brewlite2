@startuml
!theme plain
left to right direction
skinparam defaultFontName DejaVu Sans
title Use-case tổng quát — BrewLite
actor Customer as C
actor "Staff / Admin" as A
actor "VNPay / Mock" as G
rectangle BrewLite {
  usecase "Xem menu / chi tiết" as U1
  usecase "Quản lý giỏ" as U2
  usecase "Đăng ký / đăng nhập" as U3
  usecase "UC-01: Đặt và thanh toán" as U4
  usecase "Lịch sử / tracking" as U5
  usecase "UC-02: Hủy và hoàn" as U6
  usecase "Đối soát giao dịch" as U7
  usecase "Pha chế / hoàn tất" as U8
  usecase "Quản trị sản phẩm" as U9
}
C -- U1
C -- U2
C -- U3
C -- U4
C -- U5
C -- U6
G -- U4
G -- U6
G -- U7
A -- U7
A -- U8
A -- U9
note bottom of U9: Chỉ Admin quản trị sản phẩm / đối soát toàn cửa hàng.
@enduml
